<!-- Optional Grails-specific dependencies and extensions -->
<idea-plugin>
    <extensions defaultExtensionNs="org.intellij.grails">
        <!-- Grails artifact resolver extension -->
        <grailsArtifactResolver 
            implementation="com.arafat.grails.debug.util.GrailsArtifactResolver"/>
        
        <!-- GSP view locator -->
        <gspViewLocator 
            implementation="com.arafat.grails.debug.util.GspViewLocator"/>
    </extensions>
</idea-plugin>
